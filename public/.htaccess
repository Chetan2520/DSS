# Disable directory listing
Options -Indexes

RewriteEngine On
RewriteBase /

# --- 301 Redirects for Old SEO URLs to New URLs (Industry Standard) ---
RewriteRule ^performance-marketing-ppc/?$ /performance-marketing-agency-in-indore/ [R=301,L]
RewriteRule ^search-engine-optimization/?$ /seo-company-in-indore/ [R=301,L]
RewriteRule ^website-design-and-website-development/?$ /website-development-company-in-india/ [R=301,L]
RewriteRule ^social-media-marketing/?$ /social-media-marketing-company-in-indore/ [R=301,L]
RewriteRule ^influencer-marketing/?$ /influencer-marketing-agency-in-indore/ [R=301,L]
RewriteRule ^graphic-designing/?$ /graphic-designing-services-in-indore/ [R=301,L]
RewriteRule ^e-commerce-applications/?$ /ecommerce-development-company-in-indore/ [R=301,L]
# ----------------------------------------------------------------------

# 0. Rewrite sitemap.xml to sitemap.php so it is always dynamic
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# 1. Redirect /index.html to /
RewriteRule ^index\.html$ / [R=301,L]

# 2. Handle Trailing Slash (Next.js trailingSlash: true generates folders with index.html)
# If a request is for a path that doesn't end in a slash, and it's not a physical file, redirect to include the slash.
# CRITICAL: Exclude file extensions from being redirected to have a slash (e.g., .txt, .json)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteCond %{REQUEST_URI} !(\.txt|\.html|\.json|\.js|\.css|\.png|\.jpg|\.jpeg|\.svg|\.gif|\.webp)$
RewriteRule ^(.*)$ $1/ [L,R=301]

# 2.5. Rewrite missing blog routes to render.php (if the folder doesn't exist on the server)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blogs/([^/]+)/?$ /render.php?slug=$1 [L]

# 3. Serve the index.html from within the folder (Internal Rewrite for existing pages)
# This ensures that /blogs/my-slug/ serves /blogs/my-slug/index.html without a 404
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)/$ $1/index.html [L]

# 4. Fallback for SPA behavior (Optional but helpful)
# If the path doesn't exist at all, send it to the 404 page
ErrorDocument 404 /404.html


